# ── Telegram (куда слать отчёт) ─────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...
# Один или несколько chat_id через запятую
TELEGRAM_CHAT_ID=123456789

# ── Claude (анализ «почему залетело») ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# ── YouTube Data API v3 ─────────────────────────────────────
YOUTUBE_API_KEY=AIza...
# ID канала (UC...) или хэндл (@mychannel)
YOUTUBE_CHANNEL=@mychannel

# ── Instagram (Business/Creator аккаунт) ────────────────────
INSTAGRAM_ACCESS_TOKEN=EAAG... или IGAA...
# Для «Instagram API with Facebook Login»: числовой IG User ID, host graph.facebook.com
# Для «Instagram API with Instagram Login»: можно me, host graph.instagram.com
INSTAGRAM_USER_ID=me
INSTAGRAM_API_HOST=graph.instagram.com
# INSTAGRAM_API_VERSION=v23.0

# ── TikTok (Display API) ────────────────────────────────────
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_REFRESH_TOKEN=rft.…

# ── Настройки анализа ───────────────────────────────────────
# Ролик «залетел», если просмотров >= VIRAL_MULTIPLIER × медиана аккаунта
VIRAL_MULTIPLIER=2.0
VIRAL_MIN_VIEWS=1000
# Сколько дней назад смотреть ролики-кандидаты
LOOKBACK_DAYS=30
