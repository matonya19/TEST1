   "b": 58.33,
   "z": [
    1.05,
    1.09
   ],
   "c": [
    540,
    1010
   ],
   "text": "она всегда даёт какие-то интересные задания, интерактивные."
  },
  {
   "a": 58.84,
   "b": 59.8,
   "z": [
    1.2,
    1.24
   ],
   "c": [
    540,
    1010
   ],
   "text": "Ребёнок"
