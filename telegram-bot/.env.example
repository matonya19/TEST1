# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата ассистента (напишите /chatid в группе с ботом)
ASSISTANT_CHAT_ID=

# Контакт ассистента для сообщений об ошибке, например @username или +7...
ASSISTANT_CONTACT=

# Версия текста согласия — меняйте, если поменяете формулировку на экране LEAD
CONSENT_VERSION=v1
