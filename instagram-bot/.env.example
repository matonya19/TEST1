# Ключ Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Instagram (Meta for Developers → ваше приложение → Instagram API with Instagram login)
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Любая придуманная строка; та же самая вводится в настройках вебхука в Meta
IG_VERIFY_TOKEN=

# Сколько часов бот молчит в диалоге после того, как Наталья ответила сама
HUMAN_PAUSE_HOURS=12
